{
  "name": "dsh-deputy",
  "version": "0.1.0",
  "description": "DSH deputy: change-scored desktop sensing packed into 4x4 contact sheets, plus UIA-first Windows desktop acting with ROI verification.",
  "type": "module",
  "main": "src/index.mjs",
  "bin": {
    "deputy-mcp": "src/mcp/server.mjs"
  },
  "files": [
    "src/",
    "scripts/",
    "docs/",
    "cordis.patch.yml",
    "dsh.plugin.json",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "exports": {
    ".": "./src/index.mjs",
    "./runner": "./src/runner.mjs",
    "./diff": "./src/diff.mjs",
    "./sheet": "./src/sheet.mjs",
    "./mcp/server.mjs": "./src/mcp/server.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node test/run-tests.mjs",
    "mcp": "node src/mcp/server.mjs",
    "mcp:fake": "DEPUTY_FAKE=1 node src/mcp/server.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "computer-use",
    "windows",
    "ui-automation",
    "desktop-automation",
    "mcp",
    "contact-sheet"
  ],
  "author": "沐璃-Zero",
  "contributors": [
    "清弦-Zero"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "os": [
    "win32"
  ]
}
