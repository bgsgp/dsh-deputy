{
  "name": "dsh-deputy",
  "version": "0.0.22.22",
  "description": "DSH deputy: change-scored desktop sensing packed into 4x4 contact sheets, plus a real isolated Windows desktop you can actually operate in.",
  "type": "module",
  "main": "src/index.mjs",
  "bin": {"deputy-mcp": "src/mcp/server.mjs"},
  "files": ["client.js", "src/", "scripts/", "docs/", "cordis.patch.yml", "dsh.plugin.json", "README.md", "CHANGELOG.md", "LICENSE", "NOTICE"],
  "exports": {
    ".": "./src/index.mjs",
    "./client": "./client.js",
    "./desktop": "./src/desktop.mjs",
    "./viewer": "./src/viewer.mjs",
    "./runner": "./src/runner.mjs",
    "./diff": "./src/diff.mjs",
    "./sheet": "./src/sheet.mjs",
    "./mcp/server.mjs": "./src/mcp/server.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node test/run-tests.mjs",
    "mcp": "node src/mcp/server.mjs",
    "mcp:fake": "DEPUTY_FAKE=1 node src/mcp/server.mjs",
    "plugin:check": "node scripts/check-plugin.mjs",
    "publish:npm": "node scripts/publish-npm.mjs",
    "publish:npm:real": "node scripts/publish-npm.mjs --publish"
  },
  "dsh": {
    "plugin": "./dsh.plugin.json",
    "bundle": {"patch": "./cordis.patch.yml"},
    "client": {"platform": "web", "inject": ["@deepseek-ai/dsh-client-runtime", "@deepseek-ai/dsh-client-ui-layout"]}
  },
  "keywords": ["deepseek-harness", "dsh", "dsh-plugin", "dsh-client-plugin", "computer-use", "virtual-desktop", "windows", "ui-automation", "desktop-automation", "mcp", "contact-sheet"],
  "author": "沐璃-Zero",
  "contributors": ["鬼狗子-Zero"],
  "license": "MIT",
  "engines": {"node": ">=20"},
  "os": ["win32"],
  "peerDependencies": {
    "react": "^18.2.0",
    "@deepseek-ai/dsh-client-runtime": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-layout": "^0.1.0-rc.6"
  }
}
