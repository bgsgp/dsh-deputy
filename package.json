{
  "name": "dsh-deputy",
  "version": "1.2.31",
  "description": "DSH deputy: change-scored desktop sensing packed into 4x4 contact sheets, plus a real isolated Windows desktop you can actually operate in.",
  "type": "module",
  "main": "src/index.mjs",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/bgsgp/dsh-deputy.git"
  },
  "icon": "assets/icon.svg",
  "bin": {
    "deputy-mcp": "src/mcp/server.mjs"
  },
  "files": [
    "client.js",
    "assets/",
    "src/",
    "scripts/",
    "docs/",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE"
  ],
  "exports": {
    ".": "./src/index.mjs",
    "./client": "./client.js",
    "./desktop": "./src/desktop.mjs",
    "./viewer": "./src/viewer.mjs",
    "./runner": "./src/runner.mjs",
    "./diff": "./src/diff.mjs",
    "./sheet": "./src/sheet.mjs",
    "./mcp/server.mjs": "./src/mcp/server.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node test/run-tests.mjs",
    "mcp": "node src/mcp/server.mjs",
    "mcp:fake": "DEPUTY_FAKE=1 node src/mcp/server.mjs",
    "plugin:check": "node scripts/check-plugin.mjs",
    "publish:npm": "node scripts/publish-npm.mjs",
    "publish:npm:real": "node scripts/publish-npm.mjs --publish"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml",
      "platforms": [
        "win32"
      ]
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ],
      "immediately": false
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "dsh-client-plugin",
    "computer-use",
    "virtual-desktop",
    "windows",
    "ui-automation",
    "desktop-automation",
    "mcp",
    "contact-sheet"
  ],
  "author": "沐璃-Zero",
  "contributors": [
    "鬼狗子-Zero"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0",
    "dsh": ">=0.2.2-rc.1 <0.2.3-0"
  },
  "os": [
    "win32"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh": ">=0.2.2-rc.1 <0.2.3-0",
    "react": "^18.2.0"
  }
}
